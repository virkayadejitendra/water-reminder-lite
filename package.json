{
  "name": "water-reminder-lite",
  "displayName": "Water Reminder Lite",
  "description": "An offline hydration tracker with reminders, configurable drink amounts, daily totals, history, and an animated Explorer companion.",
  "version": "0.3.1",
  "publisher": "JitendraVirkayade",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#073b6f",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/virkayadejitendra/water-reminder-lite.git"
  },
  "homepage": "https://github.com/virkayadejitendra/water-reminder-lite#readme",
  "bugs": {
    "url": "https://github.com/virkayadejitendra/water-reminder-lite/issues"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["water", "reminder", "break", "hydration", "health", "wellness", "timer", "offline", "tracker"],
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": true
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce@4.0.0 package --no-dependencies --allow-missing-repository"
  },
  "contributes": {
    "commands": [
      { "command": "waterReminderLite.menu", "title": "Open Controls", "category": "Water Reminder" },
      { "command": "waterReminderLite.start", "title": "Start Reminders", "category": "Water Reminder" },
      { "command": "waterReminderLite.pause", "title": "Pause Reminders", "category": "Water Reminder" },
      { "command": "waterReminderLite.snooze", "title": "Remind Me in 5 Minutes", "category": "Water Reminder" },
      { "command": "waterReminderLite.drink", "title": "I Drank Water (Record and Restart Timer)", "category": "Water Reminder" },
      { "command": "waterReminderLite.test", "title": "Test Reminder Now", "category": "Water Reminder" },
      { "command": "waterReminderLite.interval", "title": "Change Interval", "category": "Water Reminder" },
      { "command": "waterReminderLite.amount", "title": "Change Drink Amount", "category": "Water Reminder" },
      { "command": "waterReminderLite.goal", "title": "Change Daily Goal", "category": "Water Reminder" },
      { "command": "waterReminderLite.history", "title": "View Hydration History", "category": "Water Reminder" }
    ],
    "configuration": {
      "title": "Water Reminder Lite",
      "properties": {
        "waterReminderLite.intervalMinutes": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 240,
          "scope": "application",
          "description": "Minutes between reminders (1–240). Changing this restarts an active timer."
        },
        "waterReminderLite.drinkAmountMl": {
          "type": "integer",
          "default": 200,
          "minimum": 50,
          "maximum": 2000,
          "scope": "application",
          "description": "Millilitres added to today's total when you record a drink."
        },
        "waterReminderLite.dailyGoalMl": {
          "type": "integer",
          "default": 2000,
          "minimum": 250,
          "maximum": 10000,
          "scope": "application",
          "description": "Daily water goal in millilitres, used for progress and history percentages."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "waterReminderLite.hydrationView",
          "name": "Hydration Buddy",
          "visibility": "visible"
        }
      ]
    }
  }
}
